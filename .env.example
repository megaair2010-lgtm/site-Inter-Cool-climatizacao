# Copie este arquivo para .env e preencha. NUNCA coloque senhas ou tokens aqui
# com prefixo VITE_ — tudo que começa com VITE_ vai para o navegador.

# Endpoint que recebe as solicitações de orçamento (ex.: /api/leads na Vercel/Netlify)
VITE_LEADS_ENDPOINT=/api/leads

# Google Analytics 4 (ex.: G-XXXXXXXXXX). Vazio = desativado
VITE_GA_ID=

# Google Search Console — código da meta tag de verificação. Vazio = desativado
VITE_GSC_VERIFICATION=

# Modo do roteador: "history" (produção, URLs amigáveis) ou "memory" (prévias)
VITE_ROUTER_MODE=history

# ---------- Somente no servidor (sem prefixo VITE_) ----------
# Usados pela função api/leads.ts. Configure no painel da hospedagem.
DATABASE_URL=
LEADS_NOTIFY_EMAIL=
ALLOWED_ORIGIN=https://inter-cool.vercel.app
LEADS_FROM_EMAIL=
RESEND_API_KEY=
