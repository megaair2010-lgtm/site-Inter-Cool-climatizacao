# Copie para .env (nunca versione o .env). Tokens com 16+ caracteres; gere com: openssl rand -hex 24
OFFICE_TOKENS=admin:TROQUE-ESTE-TOKEN-ADMIN:jhow,viewer:TROQUE-ESTE-TOKEN-VIEWER:equipe
OFFICE_HOST=127.0.0.1
OFFICE_PORT=4310
# ruflo | hermes | ruflo,hermes | demo (demo nunca se mistura com fontes reais)
OFFICE_SOURCES=ruflo
OFFICE_POLL_MS=2000
OFFICE_DATA_DIR=./data
# Pasta do projeto Ruflo (onde fica .claude-flow/)
RUFLO_CWD=..
RUFLO_COMMAND=npx
RUFLO_ARGS=ruflo,mcp,start
# Hermes (opcional)
HERMES_BIN=hermes
HERMES_BOARD=
